.mx_Login_submit {
    width: 100%;
    margin-top: 24px;
    margin-bottom: 24px;
}

.mx_Login_loader {
    display: inline;
    position: relative;
    top: 2px;
    left: 8px;
}

.mx_Login_loader .mx_Spinner {
    display: inline;
}

.mx_Login_loader .mx_Spinner img {
    width: 16px;
    height: 16px;
}

.mx_Login_error {
    color: $alert;
    font-weight: bold;
    text-align: center;
    margin-top: 12px;
    margin-bottom: 12px;
}

.mx_Login_error.mx_Login_serverError {
    text-align: left;
    font-weight: normal;
}

.mx_Login_error.mx_Login_serverError.mx_Login_serverErrorNonFatal {
    color: #ff8d13; /* Only used here */
}

.mx_Login_type_container {
    display: flex;
    align-items: center;
    color: $authpage-primary-color;

    .mx_Field {
        margin: 0;
    }
}

.mx_Login_type_label {
    flex: 1;
}

.mx_Login_underlinedServerName {
    width: max-content;
    border-bottom: 1px dashed $accent;
}

div.mx_AccessibleButton_kind_link.mx_Login_forgot {
    display: block;
    margin-top: 24px;

    &.mx_AccessibleButton_disabled {
        cursor: not-allowed;
    }
}

.mx_Login_spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    align-content: center;
    padding: 14px;
}

.mx_Login_fullWidthButton {
    width: 100%;
    margin-bottom: 16px;
}

.mx_Login_clientDownloads {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid $input-darker-bg-color;
    text-align: center;
}

.mx_Login_clientDownloads_title {
    margin: 0 0 12px;
    font-size: 14px;
    color: $authpage-secondary-color;
}

.mx_Login_clientDownloads_links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    align-items: center;
}

.mx_Login_clientDownloadLink {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 10px;
    border-radius: 8px;
    color: $authpage-primary-color;
    text-decoration: none;
    font-size: 12px;
    line-height: 1.2;

    &:hover,
    &:focus-visible {
        background-color: $authpage-focus-bg-color;
    }
}

.mx_Login_clientDownloadLink_storeBadge {
    display: block;
    width: auto;
    max-width: 120px;
}

.mx_Login_clientDownloadLink_label {
    color: $authpage-secondary-color;
}

